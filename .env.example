# Frontier environment variables. Copy to .env for a local run; set them in Coolify for the server.

# The app's public address.
PUBLIC_URL=
# The data disk. Holds the vault working copy, working files and derived assets.
DATA_DIR=/data

# With nothing more than PUBLIC_URL, SESSION_KEY and a disk on DATA_DIR, Frontier keeps a library of
# its own: no account is needed anywhere. DATA_DIR must be a disk that lasts across restarts.

# Only for sharing a vault through GitHub instead: the repository, as owner/name, and the settings
# below it. Leave all of these out for a library of Frontier's own.
VAULT_REPO=

# How Frontier reaches the vault on GitHub. Give ONE of the two.
# Simple: a fine-grained personal access token for the vault repository, with read and write access
# to Contents. Frontier's pushes then show as yours.
GITHUB_TOKEN=
# Or: Frontier's own GitHub App, installed on the vault repository only.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Optional. Checks the signature on GitHub's push webhook. Without a webhook the vault is fetched
# every 5 minutes.
WEBHOOK_SECRET=

# The name of the first project: the library this server has (stage 27b). A server from before
# projects keeps its library in place and gives it this name; it can be changed in the project's
# settings later. Default "Avalymia", and "Sample" for the sample (FRONTIER_SAMPLE_VAULT=1).
# More projects are made in the app, by the first account, and live in DATA_DIR/projects/.
# FRONTIER_PROJECT_NAME=Avalymia

# 32 random bytes, base64. Generate with: openssl rand -base64 32
SESSION_KEY=

# AI keys are not set here. Each person adds their own in Settings, under AI keys; it is kept only
# in their browser and sent with each request that needs it, and the server never saves it.
# OPENROUTER_API_KEY, ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY and XAI_API_KEY are no
# longer read: revoke any that you set, and remove them. SECRETS_KEY (which encrypted a key stored
# on the server) is no longer used, but it is not harmless to leave around: it opens the keys that
# older backups still hold. Remove it once no backup older than 14 days holds stored keys, and
# until then revoke those keys with each provider and make new ones for your devices.
# Only the providers' addresses can be set, which the tests use to point at stand-in servers:
# OPENROUTER_BASE_URL, ANTHROPIC_BASE_URL, OPENAI_BASE_URL, GEMINI_BASE_URL, XAI_BASE_URL.

# Optional: sign-on with Google (stage 27c). Both or neither; with neither, the buttons are hidden.
# In the Google Cloud console make an OAuth client of type "Web application" and add the redirect
# URI PUBLIC_URL/api/auth/google/callback, exactly as PUBLIC_URL is written above. Google only says
# who someone is: an account is made only from an invitation link, and never linked by email.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# (GOOGLE_ISSUER points the sign-on at another OpenID provider and is for tests; refused when
# NODE_ENV=production.)

# Optional: "off" serves a worker that removes the app's service worker from every browser that
# has it, at its next navigation, focus or reopen. Unsent changes stay. Remove it to switch back.
# FRONTIER_SERVICE_WORKER=off

# The first account, made at start while the server has none. The password is only used for that;
# change it later in Settings, or with the set-password command. Name and email default to the
# commit author's below. Logging in takes the email and the password.
FRONTIER_INITIAL_PASSWORD=
FRONTIER_INITIAL_EMAIL=
FRONTIER_INITIAL_NAME=

# The author's name and email on commits, used for a saved version when the person who saves it
# has no name or email of their own. A server from before accounts also gives them to its first
# account.
COMMIT_AUTHOR_NAME=
COMMIT_AUTHOR_EMAIL=
# The App's bot name and GitHub no-reply address, used as committer.
COMMIT_BOT_NAME=
COMMIT_BOT_EMAIL=

# Backup bucket (S3-compatible).
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_PATH_STYLE=true

# Optional, for tests and local runs.
# A Git address used in place of GitHub. The App variables and WEBHOOK_SECRET are then not required.
# VAULT_REMOTE_URL=
# A folder used in place of the bucket. The bucket variables are then not required.
# BACKUP_LOCAL_DIR=
